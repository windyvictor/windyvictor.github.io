---
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner">
    <p>© {year} {SITE_AUTHOR} · {SITE_TITLE}</p>
    <p class="muted">用 Astro 构建 · 内容以 Markdown 维护</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0 2.5rem;
  }

  .inner {
    width: min(100% - 2rem, var(--max-wide));
    margin: 0 auto;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .inner p {
    margin: 0.25rem 0;
  }

  .muted {
    opacity: 0.85;
  }

  @media (max-width: 720px) {
    .inner {
      width: 100%;
      padding: 0 18px;
      font-size: 0.85rem;
    }
  }
</style>
