---
import { SITE_TITLE, CATEGORIES } from '../consts';
const pathname = Astro.url.pathname;
---

<header class="header">
  <div class="inner">
    <a class="brand" href="/">{SITE_TITLE}</a>
    <nav class="nav" aria-label="主导航">
      <a class:list={['link', { active: pathname === '/' }]} href="/">首页</a>
      {
        CATEGORIES.map((c) => (
          <a
            class:list={[
              'link',
              { active: pathname === `/${c.slug}/` || pathname.startsWith(`/${c.slug}/`) },
            ]}
            href={`/${c.slug}/`}
          >
            {c.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    border-bottom: 1px solid var(--border);
  }

  .inner {
    width: min(100% - 2rem, var(--max-wide));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 0.6rem 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .brand:hover {
    color: var(--accent);
  }

  .nav {
    display: flex;
    gap: 0.25rem;
  }

  .link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    border-radius: 999px;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
  }

  .link:hover,
  .link.active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* 手机：品牌一行，导航五等分网格，整齐不溢出 */
  @media (max-width: 720px) {
    .inner {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.25rem 12px 0.5rem;
    }

    .brand {
      justify-content: center;
      font-size: 1.15rem;
    }

    .nav {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 4px;
    }

    .link {
      padding: 0 2px;
      font-size: 12.5px;
      line-height: 1.2;
      border-radius: 10px;
      /* min-height 继承 44px，用垂直居中保证可点区域 */
    }
  }

  @media (max-width: 340px) {
    .link {
      font-size: 11.5px;
    }
  }
</style>
