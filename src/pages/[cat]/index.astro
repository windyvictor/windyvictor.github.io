---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES } from '../../site.config';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({
    params: { cat: c.slug },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const posts = (
  await getCollection('blog', ({ data }) => !data.draft && data.category === category.label)
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title={category.label} description={category.description}>
  <div class="container py-12 sm:py-16">
    <header class="mb-8 border-b border-line pb-6">
      <p class="eyebrow">Category</p>
      <h1 class="mt-2 text-3xl font-bold tracking-[-0.02em]">{category.label}</h1>
      <p class="mt-2 text-sm text-muted">{category.description}</p>
      <p class="mt-1 font-mono text-xs text-faint">共 {posts.length} 篇</p>
    </header>
    {posts.length > 0 ? (
      <div>
        {posts.map((post, i) => (
          <PostCard post={post} index={i + 1} />
        ))}
      </div>
    ) : (
      <p class="text-muted">本栏目暂无文章。</p>
    )}
  </div>
</BaseLayout>
