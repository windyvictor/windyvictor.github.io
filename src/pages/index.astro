---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_AUTHOR } from '../consts';
import { getAllPosts } from '../lib/posts';

const recent = (await getAllPosts()).slice(0, 6);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <p class="eyebrow">{SITE_AUTHOR}</p>
    <h1>{SITE_TITLE}</h1>
    <p class="lead">{SITE_DESCRIPTION}</p>
  </section>

  <section class="block" aria-label="栏目">
    <CategoryGrid />
  </section>

  <section class="block">
    <h2 class="section-title">最近文章</h2>
    {
      recent.length === 0 ? (
        <p class="empty">还没有文章，去对应栏目目录里加一篇 Markdown 吧。</p>
      ) : (
        <div class="list">
          {recent.map(({ post, category, href }) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              href={href}
              categoryLabel={category.label}
            />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 1.5rem 0 0.5rem;
    max-width: var(--max);
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.04em;
    font-size: 0.9rem;
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .lead {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.08rem;
  }

  .block {
    margin-top: 2.5rem;
  }

  .section-title {
    margin: 0 0 1rem;
    font-size: 1.15rem;
  }

  .list {
    display: grid;
    gap: 1rem;
  }

  .empty {
    color: var(--text-muted);
  }
</style>
