---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { siteConfig, CATEGORIES } from '../site.config';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const latest = allPosts.slice(0, 6);
const tagCount = new Set(allPosts.flatMap((p) => p.data.tags)).size;
---

<BaseLayout description={siteConfig.site.description}>
  <section class="container pt-8 pb-4 sm:pt-10 sm:pb-5">
    <p class="eyebrow flex items-center gap-2">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true"></span>
      {siteConfig.site.author}
    </p>
    <h1 class="mt-4">
      <img
        src="/images/hero-title.png"
        srcset="/images/hero-title.png 1200w, /images/hero-title@2x.png 2400w"
        sizes="(min-width: 40rem) 42rem, calc(100vw - 2.5rem)"
        alt="老胡胡说 — 老胡的胡言乱语"
        width="1200"
        height="360"
        class="hero-masthead hero-masthead-light"
        decoding="async"
        fetchpriority="high"
      />
      <img
        src="/images/hero-title-dark.png"
        alt="老胡胡说 — 老胡的胡言乱语"
        width="1200"
        height="360"
        class="hero-masthead hero-masthead-dark"
        decoding="async"
      />
    </h1>
    <div class="mt-5 flex flex-wrap items-center gap-x-8 gap-y-3 font-mono text-xs uppercase tracking-[0.15em] text-faint">
      <span>{allPosts.length} 篇文章</span>
      <span>{CATEGORIES.length} 个栏目</span>
      <span>{tagCount} 个标签</span>
      <a href="/tags" class="text-accent hover:text-accent2 transition-colors link-sweep">浏览标签 →</a>
    </div>
  </section>

  <section class="container pt-2 pb-12 sm:pt-3 sm:pb-16">
    <div class="flex items-end justify-between mb-6 border-b border-line pb-4">
      <div>
        <p class="eyebrow">Latest notes</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.01em]">最新文章</h2>
      </div>
      <a href="/blog" class="font-mono text-xs uppercase tracking-[0.15em] text-muted hover:text-accent transition-colors">查看全部 →</a>
    </div>
    <div>
      {latest.map((post, i) => (
        <PostCard post={post} index={i + 1} />
      ))}
    </div>
  </section>
</BaseLayout>
